rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Public site content ──────────────────────────────────────────────
    // Public read and admin management
    match /services/{id}      { allow read, write: if true; }
    match /packages/{id}      { allow read, write: if true; }
    match /blog_posts/{id}    { allow read, write: if true; }
    match /testimonials/{id}  { allow read, write: if true; }
    match /process_steps/{id} { allow read, write: if true; }
    match /site_data/{id}     { allow read, write: if true; }

    // ─── Contact form submissions ─────────────────────────────────────────
    match /contact_submissions/{id} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // ─── Partner & Resort Package Requests ─────────────────────────────────
    match /package_requests/{id} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // ─── Video Reels Interactions (Likes & Comments) ──────────────────────
    match /video_comments/{id} {
      allow read, write: if true;
    }

    match /video_likes/{id} {
      allow read, write: if true;
    }
  }
}
